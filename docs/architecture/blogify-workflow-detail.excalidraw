    {
      "id": "120199bfb76c43439dd7",
      "type": "text",
      "x": 55,
      "y": 1245,
      "width": 1640,
      "height": 64,
      "angle": 0,
      "strokeColor": "#39465b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a000066",
      "roundness": null,
      "seed": 1122,
      "version": 1,
      "versionNonce": 2046,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 1,
      "text": "Review wait is durable state, not a running worker. The worker releases execution ownership while a user reviews; a decision is committed with a new outbox event. Redis Pub/Sub only wakes workers; the durable list/outbox and PostgreSQL leases govern recovery.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Review wait is durable state, not a running worker. The worker releases execution ownership while a user reviews; a decision is committed with a new outbox event. Redis Pub/Sub only wakes workers; the durable list/outbox and PostgreSQL leases govern recovery.",
      "autoResize": true,
      "lineHeight": 1.25
    },
