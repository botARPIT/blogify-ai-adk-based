# Blogify AI Production Environment Variables
# Copy this to .env and update values

# Database
POSTGRES_DB=blogify
POSTGRES_USER=blogify
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://blogify:changeme_strong_password@postgres:5432/blogify

# Redis
REDIS_URL=redis://redis:6379/0

# API Keys
GOOGLE_API_KEY=your_google_api_key_here
# Optional Google Custom Search fallback (requires an existing API account)
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_programmable_search_engine_id_here
TAVILY_API_KEY=your_tavily_api_key_here

# Environment
ENVIRONMENT=prod

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=blogify-api
METRICS_BEARER_TOKEN=generate_a_long_random_token

# Elasticsearch (use separate writer and read-only accounts)
ELASTICSEARCH_URL=https://your-elasticsearch-endpoint:9200
ELASTICSEARCH_FILEBEAT_USERNAME=blogify-filebeat
ELASTICSEARCH_FILEBEAT_PASSWORD=replace_with_secret
ELASTICSEARCH_GRAFANA_USERNAME=blogify-grafana-readonly
ELASTICSEARCH_GRAFANA_PASSWORD=replace_with_secret

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_strong_password

# API URL (for frontend)
API_URL=https://api.yourdomain.com

# Optional: Session secret
SESSION_SECRET=your_session_secret_here
