# Copy to .env.prod in the repository root. Never commit the populated file.
# Deployment: docs/runbooks/azure-vm.md
BACKEND_IMAGE=blogify-backend:local
API_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=you@example.com
CORS_ORIGINS=https://your-frontend.example.com

# Use a hex password (openssl rand -hex 24) to avoid URL-escaping problems.
POSTGRES_DB=blogify
POSTGRES_USER=blogify
POSTGRES_PASSWORD=replace_with_random_hex_password
DATABASE_URL=postgresql+asyncpg://blogify:replace_with_random_hex_password@postgres:5432/blogify
REDIS_URL=redis://redis:6379/0

# Generate each secret independently: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_random_secret
ADMIN_API_KEY=replace_with_random_secret
METRICS_BEARER_TOKEN=replace_with_random_secret
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace_with_random_secret

# Google is the production default. For Ollama, set provider/model/base/key together.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=replace_with_google_api_key
TAVILY_API_KEY=replace_with_tavily_api_key
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=replace_with_ollama_key
# Google Custom Search credentials are optional; native Gemini Search needs neither.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
